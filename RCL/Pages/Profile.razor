@page "/profile"
@using RCL.Dtos.Response
@inject RestService RestService
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation

<div class="container mt-3">
    <h3 class="mb-3">Profile</h3>

    @if (!AuthStateService.IsLoggedIn)
    {
        <div class="alert alert-warning">
            You need to login to view your profile.
        </div>
        <button class="btn btn-primary" @onclick="GoLogin">
            Go to login
        </button>
    }

    @if (_loading)
    {
        <div class="text-muted">Loading...</div>
    }

    @if (_profile is not null)
    {
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <strong>Account</strong>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <div class="text-muted small">Name</div>
                            <div class="fw-semibold">@($"{_profile.Name} {_profile.Surname}".Trim())</div>
                        </div>

                        <div class="mb-2">
                            <div class="text-muted small">Email</div>
                            <div class="fw-semibold">@_profile.Email</div>
                        </div>

                        <div class="mb-2">
                            <div class="text-muted small">NIF</div>
                            <div class="fw-semibold">@(_profile.Nif?.ToString() ?? "-")</div>
                        </div>

                        <div class="mb-0">
                            <div class="text-muted small">Status</div>
                            <span class="badge bg-secondary">@_profile.Status</span>
                        </div>
                    </div>
                </div>

                <div class="d-grid mt-3">
                    <button class="btn btn-outline-secondary" @onclick="Reload">
                        Refresh
                    </button>
                </div>
            </div>
            @if (AuthStateService.IsSupplier)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="m-0">My products</h4>
                    <button class="btn btn-primary" @onclick="GoAddProduct">
                        + Add product
                    </button>
                </div>

                if (!_prodcuts.Any())
                {
                    <div class="alert alert-secondary">No products yet.</div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var p in _prodcuts)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@p.Name</div>
                                    <div class="text-muted small">
                                        Stock: @p.Stock • Price: @p.Price.ToString("0.00") €
                                    </div>
                                </div>
                                <span class="badge bg-secondary">@p.Status</span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="col-12 col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <strong>Order history</strong>
                            <span class="text-muted small">@_orders.Count item(s)</span>
                        </div>

                        <div class="card-body p-0">
                            @if (_orders.Count == 0)
                            {
                                <div class="p-3 text-muted">
                                    No orders yet.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                        <tr>
                                            <th style="width: 120px;">Order</th>
                                            <th style="width: 170px;">Date</th>
                                            <th>Status</th>
                                            <th class="text-end" style="width: 140px;">Total</th>
                                            <th style="width: 110px;"></th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var o in _orders)
                                        {
                                            <tr>
                                                <td>#@o.OrderId</td>
                                                <td>@o.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <span class="badge bg-secondary">@o.Status</span>
                                                </td>
                                                <td class="text-end fw-semibold">@o.TotalAmount.ToString("0.00") €</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ViewOrder(o.OrderId)">
                                                        View
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private readonly List<string> _errors = new();

    private ProfileDto? _profile;
    private List<OrderSummaryDto> _orders = new();
    private List<ProductResponseDto> _prodcuts = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _errors.Clear();
        _loading = true;

        try
        {
            if (!AuthStateService.IsLoggedIn) return;

            _profile = await RestService.GetProfile();

            if (AuthStateService.IsSupplier)
            {
                var prodcuts = await RestService.GetUserProducts();
                _prodcuts = prodcuts.ToList();
            }
            else
            {
                var orders = await RestService.GetUserOrders();
                _orders = orders.ToList();
            }
        }
        catch (Exception ex)
        {
            _errors.Add(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Reload() => await Load();

    private void GoLogin() => Navigation.NavigateTo("/login?returnUrl=/profile");

    private void ViewOrder(int orderId)
    {
        Navigation.NavigateTo($"/order-confirmation/{orderId}");
    }
    
    private void GoAddProduct() => Navigation.NavigateTo("/supplier/products/new");


}
