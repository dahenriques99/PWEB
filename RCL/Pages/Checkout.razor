@page "/checkout"
@using RCL.Dtos.Request
@using RCL.Dtos.Response
@inject CartService Cart
@inject AuthStateService AuthStateService
@inject RestService RestService
@inject NavigationManager Navigation

<div class="container mt-3">
    <h3>Checkout</h3>

    @if (!Cart.Items.Any())
    {
        <div class="alert alert-secondary">
            Your cart is empty.
        </div>
        <button class="btn btn-primary" @onclick="GoHome">Browse products</button>
    }
    else if (!AuthStateService.IsLoggedIn)
    {
        <div class="alert alert-warning">
            Please login to continue checkout.
        </div>
        <button class="btn btn-primary" @onclick="GoLogin">Login</button>
    }
    else if (AuthStateService.IsSupplier)
    {
        <div class="alert alert-warning">
            Suppliers cannot checkout.
        </div>
        <button class="btn btn-primary" @onclick="GoHome">Back</button>
    }
    else
    {
        @if (_errors.Any())
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var e in _errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="card">
                    <div class="card-header bg-white">
                        <strong>Items</strong>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Cart.Items)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <div class="fw-semibold">@item.Name</div>
                                    <div class="text-muted small">@item.UnitPrice.ToString("0.00") €</div>
                                </div>
                                <div class="text-end">
                                    <div>x @item.Quantity</div>
                                    <div class="fw-semibold">@((item.UnitPrice * item.Quantity).ToString("0.00")) €
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (_deliveryMethods == null)
                {
                    <p class="text-muted"><em>Loading delivery methods...</em></p>
                }
                else if (!_deliveryMethods.Any())
                {
                    <div class="alert alert-warning">No delivery methods available.</div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header bg-white">
                            <strong>Delivery Mode</strong>
                        </div>
                        <div class="card-body">
                            <InputSelect class="form-select" @bind-Value="_selectedDeliveryMethod">
                                <option value="0" disabled>-- Select a delivery mode --</option>

                                @foreach (var m in _deliveryMethods)
                                {
                                    <option value="@m.Id">@m.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                }
            </div>

            <div class="col-12 col-lg-5">
                <div class="card">
                    <div class="card-header bg-white">
                        <strong>Summary</strong>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Items</span>
                            <span class="fw-semibold">@Cart.TotalItems</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">Total</span>
                            <span class="fw-bold">@Cart.TotalPrice.ToString("0.00") €</span>
                        </div>

                        <div class="d-grid mt-3">
                            <button class="btn btn-primary"
                                    disabled="@_isSubmitting"
                                    @onclick="PlaceOrder">
                                @(_isSubmitting ? "Placing order..." : "Place order")
                            </button>
                        </div>

                        <div class="d-grid mt-2">
                            <button class="btn btn-outline-secondary"
                                    disabled="@_isSubmitting"
                                    @onclick="GoCart">
                                Back to cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _isSubmitting;
    private readonly List<string> _errors = new();
    private List<DeliveryMethodsResponseDto>? _deliveryMethods;
    private int _selectedDeliveryMethod = 0;

    private void GoLogin() => Navigation.NavigateTo("/login?returnUrl=/checkout");
    private void GoHome() => Navigation.NavigateTo("/");
    private void GoCart() => Navigation.NavigateTo("/cart");

    protected async override Task OnInitializedAsync()
    {
        _deliveryMethods = await RestService.GetDeliveryMethods();
        _selectedDeliveryMethod = _deliveryMethods.FirstOrDefault()?.Id ?? 0;
    }

    private async Task PlaceOrder()
    {
        _errors.Clear();
        _isSubmitting = true;

        try
        {
            var req = new CheckoutRequestDto
            {
                Items = Cart.Items.Select(i => new CheckoutItemDto
                {
                    ProductId = i.ProductId,
                    Quantity = i.Quantity,
                }).ToList(),
                DeliveryMode = _selectedDeliveryMethod
            };

            var resp = await RestService.Checkout(req);

            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<CheckoutResponseDto>();
                if (dto is null)
                {
                    _errors.Add("Checkout failed: invalid server response.");
                    return;
                }

                Cart.Clear();
                Navigation.NavigateTo($"/order-confirmation/{dto.OrderId}");
                return;
            }

            var apiErr = await resp.Content.ReadFromJsonAsync<ApiErrorResponse>();
            if (apiErr?.Errors?.Any() == true) _errors.AddRange(apiErr.Errors);
            else _errors.Add("Checkout failed.");
        }
        catch (Exception ex)
        {
            _errors.Add(ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

}