@inject AuthStateService Auth

<div class="top-row ps-3 navbar navbar-dark">
    <NavLink href="" class="container-fluid">
        <a class="navbar-brand">MyMedia</a>
    </NavLink>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            @if (Auth.IsLoggedIn)
            {
                <NavLink class="nav-link" href="profile">
                    <span class="bi bi-person-fill nav-menu-icon" aria-hidden="true"></span> Profile
                </NavLink>

                <NavLink class="nav-link" href="cart">
                    <span class="bi bi-cart-fill nav-menu-icon" aria-hidden="true"></span> Cart
                </NavLink>

                <NavLink class="nav-link" href="">
                    <span class="bi bi-box-arrow-right nav-menu-icon" aria-hidden="true"></span> Logout
                </NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-lock-fill nav-menu-icon" aria-hidden="true"></span> Login
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {

    protected override void OnInitialized()
    {
        Auth.Changed += StateHasChanged;
    }

    private async Task Logout()
    {
        Auth.Clear();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.Changed -= StateHasChanged;
    }

}