@inject AuthStateService Auth
@inject RestService RestService
@inject CartService Cart
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <NavLink href="/" class="navbar-brand">MyMedia</NavLink>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            @if (!Auth.IsSupplier)
            {
                <NavLink class="nav-link" href="cart">
                    <span class="bi bi-cart-fill nav-menu-icon"></span>
                    Cart
                    @if (Cart.TotalItems > 0)
                    {
                        <span class="badge bg-primary ms-2">@Cart.TotalItems</span>
                    }
                </NavLink>
            }
            @if (Auth.IsLoggedIn)
            {
                <NavLink class="nav-link" href="profile">
                    <span class="bi bi-person-fill nav-menu-icon" aria-hidden="true"></span> Profile
                </NavLink>

                <NavLink class="nav-link" href="" @onclick="Logout">
                    <span class="bi bi-box-arrow-right nav-menu-icon" aria-hidden="true"></span>
                    Logout
                </NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-lock-fill nav-menu-icon" aria-hidden="true"></span> Login
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {

    protected override void OnInitialized()
    {
        Auth.Changed += OnStateChanged;
        Cart.Changed += OnStateChanged;
    }
    
    private void OnStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await RestService.Logout();
    }
    
    public void Dispose()
    {
        Auth.Changed -= StateHasChanged;
    }
}