@page "/categories"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyMedia.Infrastructure.Entities
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory

<PageTitle>Categories</PageTitle>

<h1 class="mb-3">Categories</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">
        Manage your categories
    </span>

    <a class="btn btn-primary" href="/categories/create">
        + Create Category
    </a>
</div>

<QuickGrid Items="_categories" Class="table table-striped align-middle" Virtualize="true">
    <PropertyColumn Property="c => c.Name" Sortable="true" />
    <PropertyColumn Property="c => c.Description" />

    <TemplateColumn Title="Parent Category" Sortable="true">
        @if (string.IsNullOrEmpty(context.ParentCategory?.Name))
        {
            @($"—")
        }
        else
        {
            @context.ParentCategory?.Name
        }
    </TemplateColumn>

    <TemplateColumn Title="Actions" Context="category">
        <div class="btn-group btn-group-sm" role="group">
            <a class="btn btn-outline-secondary"
               href="@($"/categories/edit?id={category.Id}")">
                Edit
            </a>
            <a class="btn btn-outline-info"
               href="@($"/categories/details?id={category.Id}")">
                Details
            </a>
            <a class="btn btn-outline-danger"
               href="@($"/categories/delete?id={category.Id}")">
                Delete
            </a>
        </div>
    </TemplateColumn>
</QuickGrid>

@if (!_categories.Any())
{
    <div class="alert alert-info mt-3">
        No categories found. Create your first one!
    </div>
}

@code {
    private IQueryable<Category> _categories = Enumerable.Empty<Category>().AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        var context = await DbFactory.CreateDbContextAsync();

        _categories = context.Categories
            .Include(c => c.ParentCategory)
            .AsNoTracking();
    }
}
