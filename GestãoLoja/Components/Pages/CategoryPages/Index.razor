@page "/categories"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyMedia.Infrastructure
@implements IAsyncDisposable
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory

<PageTitle>Categories</PageTitle>

<h1>Categories</h1>

<p>
    <a href="categories/create" class="btn btn-primary">Create New</a>
</p>

<QuickGrid Class="table" Items="_context.Categories">
    <PropertyColumn Property="category => category.Name"/>
    <PropertyColumn Property="category => category.Description"/>
    
    <TemplateColumn Title="Parent Category" Context="category">
        @if (category.ParentCategory is null)
        {
            <span>None</span>
        }
        else
        {
            @category.ParentCategory.Name
        }
    </TemplateColumn>

    <TemplateColumn Context="category">
        <a href="@($"categories/edit?id={category.Id}")">Edit</a> |
        <a href="@($"categories/details?id={category.Id}")">Details</a> |
        <a href="@($"categories/delete?id={category.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext _context = default!;

    protected override void OnInitialized()
    {
        _context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await _context.DisposeAsync();
}
