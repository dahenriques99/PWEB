@page "/admin/users"
@attribute [Authorize(Roles = "Admin, Worker")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure
@using MyMedia.Infrastructure.Entities.enums
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>User Management</PageTitle>

<h1>User Management</h1>

<div class="row mb-3 align-items-end">
    <div class="col-md-4">
        <label class="form-label">Role</label>
        <InputSelect @bind-Value="_selectedRole" class="form-select">
            <option value="">All Roles</option>
            @foreach (var role in Enum.GetNames<UserRoles>())
            {
                <option value="@role">@role</option>
            }
        </InputSelect>
    </div>

    <div class="col-md-4">
        <label class="form-label">Status</label>
        <InputSelect @bind-Value="_selectedStatus" class="form-select">
            <option value="">All Status</option>
            @foreach (var status in Enum.GetNames<UserStatus>())
            {
                <option value="@status">@status</option>
            }
        </InputSelect>
    </div>

    <div class="col-md-4 text-end">
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">
            Clear Filters
        </button>
    </div>
</div>


<QuickGrid Class="table table-striped table-hover" Items="FilteredUsers">
    <PropertyColumn Property="user => user.Name" Title="Name" Sortable="true"/>
    <PropertyColumn Property="user => user.Email" Title="Email" Sortable="true"/>

    <TemplateColumn Context="user" Title="Roles">
        @foreach (var role in GetUserRoles(user))
        {
            <span class="badge bg-info">@role</span>
        }
    </TemplateColumn>

    <TemplateColumn Context="user" Title="Status">
        @switch (user.Status)
        {
            case UserStatus.Active:
                <span class="badge bg-success">Active</span>
                break;

            case UserStatus.Pending:
                <span class="badge bg-warning text-dark">Pending</span>
                <button class="btn btn-sm btn-success ms-2"
                        @onclick="() => ConfirmUser(user)">
                    Activate
                </button>
                break;

            default:
                <span class="badge bg-secondary">@user.Status</span>
                <button class="btn btn-sm btn-success ms-2"
                        @onclick="() => ConfirmUser(user)">
                    Activate
                </button>
                break;
        }
    </TemplateColumn>

    <TemplateColumn Context="user" Align="Align.End">
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-primary"
               href="@($"admin/users/edit?id={user.Id}")">
                Edit
            </a>
            <a class="btn btn-sm btn-secondary"
               href="@($"admin/users/details?id={user.Id}")">
                Details
            </a>
            @if (user.Status == UserStatus.Active && !IsAdmin(user))
            {
                <button class="btn btn-sm btn-danger"
                        @onclick="() => DeactivateUser(user)">
                    Deactivate
                </button>
            }
        </div>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext _context = default!;

    private string? _selectedRole; // Selected role from dropdown
    private string? _selectedStatus; // Selected email confirmation status from dropdown
    private IQueryable<ApplicationUser> FilteredUsers => FilterUsers();

    private Dictionary<string, List<string>> _userRoles = new();

    protected override async Task OnInitializedAsync()
    {
        // Create a new DbContext instance for this page
        _context = await DbContextFactory.CreateDbContextAsync();
        _userRoles = await _context.UserRoles
            .Join(_context.Roles,
                ur => ur.RoleId,
                r => r.Id,
                (ur, r) => new { ur.UserId, r.Name })
            .GroupBy(x => x.UserId)
            .ToDictionaryAsync(
                g => g.Key,
                g => g.Select(x => x.Name!).ToList()
            );
    }

    private bool IsAdmin(ApplicationUser user)
    {
        return _userRoles.TryGetValue(user.Id, out var roles)
               && roles.Contains(nameof(UserRoles.Admin));
    }


    private IQueryable<ApplicationUser> FilterUsers()
    {
        var query = _context.Users.AsQueryable();

        //Admin, 
        if (!string.IsNullOrEmpty(_selectedRole))
        {
            query = query.Where(u => _context.UserRoles
                .Where(ur => ur.UserId == u.Id)
                .Join(_context.Roles, ur => ur.RoleId, r => r.Id, (ur, r) => r.Name)
                .Contains(_selectedRole));
        }

        if (!string.IsNullOrEmpty(_selectedStatus))
        {
            query = _selectedStatus switch
            {
                nameof(UserStatus.Pending) => query.Where(u => u.Status == UserStatus.Pending),
                nameof(UserStatus.Active) => query.Where(u => u.Status == UserStatus.Active),
                _ => query
            };
        }

        return query;
    }


    private async Task ConfirmUser(ApplicationUser user)
    {
        user.Status = UserStatus.Active;
        _context.Users.Update(user);
        await _context.SaveChangesAsync();
    }


    private IEnumerable<string> GetUserRoles(ApplicationUser user)
        => _userRoles.TryGetValue(user.Id, out var roles)
            ? roles
            : Enumerable.Empty<string>();

    private async Task DeactivateUser(ApplicationUser user)
    {
        if (IsAdmin(user))
            return; // or throw

        user.Status = UserStatus.Inactive;
        _context.Users.Update(user);
        await _context.SaveChangesAsync();
    }

    private void ClearFilters()
    {
        _selectedRole = null;
        _selectedStatus = null;
    }
}