@page "/admin/users"
@attribute [Authorize(Roles = "Admin, Worker")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using MyMedia.Domain.Entities.enums
@using MyMedia.Infrastructure
@using MyMedia.Infrastructure.Entities.enums
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>User Management</PageTitle>

<h1>User Management</h1>

<!-- Filter by Role Dropdown -->
<div class="row mb-3">
    <div class="col-md-4">
        <label for="roleFilter" class="form-label">Filter by Role:</label>
        <InputSelect id="roleFilter" @bind-Value="_selectedRole" class="form-select">
            <option value="">All Roles</option>
            @foreach (var role in Enum.GetValues(typeof(UserRole)))
            {
                <option value="@role">@role</option>
            }
        </InputSelect>
    </div>
</div>

<!-- Filter by Status -->
<div class="row mb-3">
    <div class="col-md-4">
        <label for="statusFilter" class="form-label">Filter by Status:</label>
        <InputSelect id="statusFilter" @bind-Value="_selectedStatus" class="form-select">
            <option value="">All Status</option>
            @foreach (var status in Enum.GetValues(typeof(UserStatus)))
            {
                <option value="@status">@status</option>
            }
        </InputSelect>
    </div>
</div>

<QuickGrid Class="table" Items="FilteredUsers">
    <PropertyColumn Property="user => user.Name" Title="Name" Sortable="true"/>
    <PropertyColumn Property="user => user.Email" Title="Email" Sortable="true"/>
    <PropertyColumn Property="user => user.ClientType" Title="Client Type" Sortable="true"></PropertyColumn>

    <TemplateColumn Context="user" Title="Roles">
        @foreach (var role in GetUserRoles(user))
        {
            <span class="badge bg-info">@role</span>
        }
    </TemplateColumn>

    <TemplateColumn Context="user" Title="Status">
        @if (user.Status == UserStatus.Active)
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-warning">Pending</span>
            <button class="btn btn-sm btn-primary ms-2" @onclick="() => ConfirmUser(user)">
                Activate
            </button>
        }
    </TemplateColumn>
    
    <TemplateColumn Title="Actions" Context="user">
        <a href="@($"admin/users/edit?id={user.Id}")">Edit</a> |
        <a href="@($"admin/users/details?id={user.Id}")">Details</a>
        @* <a href="@($"products/delete?id={product.Id}")">Delete</a> *@
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext _context = default!;

    private string? _selectedRole; // Selected role from dropdown
    private string? _selectedStatus; // Selected email confirmation status from dropdown
    private IQueryable<ApplicationUser> FilteredUsers => FilterUsers();

    protected override async Task OnInitializedAsync()
    {
        // Create a new DbContext instance for this page
        _context = await DbContextFactory.CreateDbContextAsync();
    }

    private IQueryable<ApplicationUser> FilterUsers()
    {
        var query = _context.Users.AsQueryable();

        //Admin, 
        if (!string.IsNullOrEmpty(_selectedRole))
        {
            query = query.Where(u => _context.UserRoles
                .Where(ur => ur.UserId == u.Id)
                .Join(_context.Roles, ur => ur.RoleId, r => r.Id, (ur, r) => r.Name)
                .Contains(_selectedRole));
        }

        if (!string.IsNullOrEmpty(_selectedStatus))
        {
            query = _selectedStatus switch
            {
                nameof(UserStatus.Pending) => query.Where(u => u.Status == UserStatus.Pending),
                nameof(UserStatus.Active) => query.Where(u => u.Status == UserStatus.Active),
                _ => query
            };
        }

        return query;
    }


    private async Task ConfirmUser(ApplicationUser user)
    {
        try
        {
            await using var newContext = await DbContextFactory.CreateDbContextAsync();
            // Set email confirmed status
            user.Status = UserStatus.Active;

            // Update the user in the database
            newContext.Users.Update(user);
            await newContext.SaveChangesAsync(); // Save changes to confirm the client

            // Explicitly refresh the UI to reflect the change
            StateHasChanged(); // Refresh the UI
        }
        catch (Exception ex)
        {
            // Log or handle the exception as needed
            await Console.Error.WriteLineAsync($"Error confirming client: {ex.Message}");
        }
    }

    private List<string?> GetUserRoles(ApplicationUser user)
    {
        using var newContext = DbContextFactory.CreateDbContext();
        return newContext.UserRoles
            .Where(ur => ur.UserId == user.Id)
            .Join(newContext.Roles, ur => ur.RoleId, r => r.Id, (ur, r) => r.Name)
            .ToList(); // Fetch roles as a list of role names
    }

}