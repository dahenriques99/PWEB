@page "/users"
@attribute [Authorize(Roles = "Admin, Worker")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using MyMedia.Infrastructure
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<p>
    <a href="users/create">Create New</a>
</p>

<!-- Filter by Role Dropdown -->
<div class="row mb-3">
    <div class="col-md-4">
        <label for="roleFilter" class="form-label">Filter by Role:</label>
        <InputSelect id="roleFilter" @bind-Value="_selectedRole" class="form-select">
            <option value="">All Roles</option>
            <option value="Admin">Admin</option>
            <option value="Worker">Worker</option>
            <option value="Client">Client</option>
            <option value="NoRole">No Role</option> <!-- For users with no role -->
        </InputSelect>
    </div>
</div>

<!-- Filter by Email Confirmation Status -->
<div class="row mb-3">
    <div class="col-md-4">
        <label for="statusFilter" class="form-label">Filter by Status:</label>
        <InputSelect id="statusFilter" @bind-Value="_selectedStatus" class="form-select">
            <option value="">All Statuses</option>
            <option value="Confirmed">Confirmed</option>
            <option value="Pending">Pending</option>
        </InputSelect>
    </div>
</div>

<QuickGrid Class="table" Items="_context?.Users">
    <PropertyColumn Property="user => user.UserName" Title="Name" Sortable="true" />
    <PropertyColumn Property="user => user.Email" Title="Email" Sortable="true" />

    <!-- Roles Column -->
    <TemplateColumn Context="user" Title="Roles">
        @foreach (var role in GetUserRoles(user))
        {
            <span class="badge bg-info">@role</span>
        }
    </TemplateColumn>

    <TemplateColumn Context="user" Title="Status">
        @if (user.EmailConfirmed)
        {
            <span class="badge bg-success">Confirmed</span>
        }
        else
        {
            <span class="badge bg-warning">Pending</span>
            @if (_isAdmin)
            {
                <button class="btn btn-sm btn-primary ms-2" @onclick="() => ConfirmClient(user)">Confirm Client</button>
            }
        }
    </TemplateColumn>

    <TemplateColumn Context="user" Title="Image">
        @* <ImageDisplay ImageData="@user.ImageData" Type="tiny" /> *@
    </TemplateColumn>

    <TemplateColumn Context="user">
        <a href="@($"users/edit?id={user.Id}")" class="btn">Edit</a>
        <a href="@($"users/edit?id={user.Id}")" class="btn">Details</a>
        <a href="@($"users/edit?id={user.Id}")" class="btn btn-danger">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext? _context;
    private bool _isAdmin = false;
    private string? _selectedRole; // Selected role from dropdown
    private string? _selectedStatus; // Selected email confirmation status from dropdown
    
    List<ApplicationUser>? users;
    Dictionary<string, List<String>> usersWithRoles = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadData();
        // Create a new DbContext instance for this page
        _context = await DbContextFactory.CreateDbContextAsync();

        // Get the current logged-in user's roles
        var currentUser = await UserManager.GetUserAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        var currentUserRoles = await UserManager.GetRolesAsync(currentUser);
        _isAdmin = currentUserRoles.Contains("Admin");
        
        await _context.SaveChangesAsync(); // Add this for correct async behavior
    }

    private async Task LoadData()
    {
        users = UserManager.Users.ToList();

        foreach (var user in users)
        {
            var userRoles = await UserManager.GetRolesAsync(user);
            usersWithRoles[user.Id] = userRoles.ToList();
        }
    }

    // Get the roles for a specific user
    private List<string?> GetUserRoles(ApplicationUser user)
    {
        using var newContext = DbContextFactory.CreateDbContext();
        
        return newContext.UserRoles
            .Where(ur => ur.UserId == user.Id)
            .Join(newContext.Roles,
                ur => ur.RoleId,
                r => r.Id, 
                (ur, r) => r.Name)
            .ToList(); // Fetch roles as a list of role names
    }

    private async Task ConfirmClient(ApplicationUser user)
    {
        try
        {
            await using var newContext = await DbContextFactory.CreateDbContextAsync();
            // Set email confirmed status
            user.EmailConfirmed = true;

            // Update the user in the database
            newContext.Users.Update(user);
            await newContext.SaveChangesAsync(); // Save changes to confirm the client

            // Explicitly refresh the UI to reflect the change
            StateHasChanged(); // Refresh the UI
        }
        catch (Exception ex)
        {
            // Log or handle the exception as needed
            await Console.Error.WriteLineAsync($"Error confirming client: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_context != null) await _context.DisposeAsync();
    }

}