@page "/admin/users/details"
@attribute [Authorize(Roles = "Admin, Worker")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>User Details</PageTitle>

@if (_user is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="container my-5">
        <h1 class="text-center mb-4">User Details</h1>
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <h2 class="card-title">@_user.Name @_user.Surname</h2>
                    <hr/>
                    <div class="col-md-4">
                        <div class="d-flex justify-content-center">
                            @if (_user.ImageData is { Length: > 0 })
                            {
                                <img src="@($"data:image/png;base64,{Convert.ToBase64String(_user.ImageData)}")"
                                     alt="User image"
                                     class="img-fluid" style="max-width: 50px;"/>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@_user.Email</dd>
                        <dt class="col-sm-3">Phone Number</dt>
                        <dd class="col-sm-9">@_user.PhoneNumber</dd>
                        @if (_user.Nif is not null)
                        {
                            <dt class="col-sm-3">NIF</dt>
                            <dd class="col-sm-9">@_user.Nif</dd>
                        }
                    </dl>
                    <dl class="row">
                        <h3>Products</h3>
                        <hr/>
                        @if (_user.Orders.Any())
                        {
                            @* <div class="d-flex flex-wrap"> *@
                            @*     @foreach (var order in _user.Orders) *@
                            @*     { *@
                            @*         <a class="text-decoration-none" *@
                            @*            href="@($"/products/details?id={order.}")"> *@
                            @*             <Card Title="@($"{@order.Name} x {}")" *@
                            @*                   ImageData="@cartProduct.Product.ImageData" Border="true"/> *@
                            @*         </a> *@
                            @*     } *@
                            @* </div> *@
                        }
                        else
                        {
                            <p>This user has no products in the cart.</p>
                        }
                    </dl>
                </div>
                <div class="text-center mt-4">
                    <a href="@($"/admin/users/edit?id={_user?.Id}")" class="btn btn-primary">Edit</a>
                    <a href="@($"/admin/users")" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ApplicationUser? _user;

    [SupplyParameterFromQuery] private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _user = await context.Users.FirstOrDefaultAsync(u => u.Id == Id);
        if (_user is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
        // user = await context.Users
        //     .Include(user => user.CartProducts)
        //     .ThenInclude(cartProduct => cartProduct.Product)
        //     .FirstOrDefaultAsync(m => m.Id == Id);
    }

}