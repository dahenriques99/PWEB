@page "/admin/users/details"
@attribute [Authorize(Roles = "Admin, Employee")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>User Details</PageTitle>

@if (_user is null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Loading user details…</p>
    </div>
}
else
{
    <div class="container my-5">
        <div class="card shadow-sm">
            <div class="card-body">

                <!-- Header -->
                <div class="d-flex align-items-center mb-4">
                    <img class="rounded-circle me-4"
                         style="width: 90px; height: 90px; object-fit: cover"
                         src="@GetUserImage()"
                         alt="User image"/>

                    <div>
                        <h3 class="mb-0">@_user.Name @_user.Surname</h3>
                        <span class="text-muted">@_user.Email</span>
                    </div>
                </div>

                <hr />

                <!-- User info -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <strong>Email:</strong><br />
                        @if(!string.IsNullOrEmpty(_user.Email))
                        { @_user.Email}
                        else
                        { @($"—") }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_user.Nif))
                    {
                        <div class="col-md-6">
                            <strong>NIF:</strong><br />
                            @_user.Nif
                        </div>
                    }
                </div>

                <hr />

                <!-- Orders -->
                <h5 class="mb-3">Orders</h5>

                @if (_user.Orders.Any())
                {
                    <ul class="list-group mb-4">
                        @foreach (var order in _user.Orders)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>
                                    <strong>#@order.Id</strong> – @order.Date.ToShortDateString()
                                </span>
                                <span class="badge bg-primary">
                                    € @order.TotalAmount
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">This user has no orders.</p>
                }

                <!-- Actions -->
                <div class="d-flex gap-2 justify-content-end">
                    <a class="btn btn-primary"
                       href="@($"/admin/users/edit?id={_user.Id}")">
                        Edit
                    </a>

                    <a class="btn btn-secondary"
                       href="/admin/users">
                        Back
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ApplicationUser? _user;

    [SupplyParameterFromQuery] private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _user = await context.Users.FirstOrDefaultAsync(u => u.Id == Id);
        if (_user is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
    private string GetUserImage()
    {
        return _user?.ImageData is { Length: > 0 } ? 
            $"data:image/png;base64,{Convert.ToBase64String(_user.ImageData)}" : 
            "/img/default-user.png"; // fallback
    }

}