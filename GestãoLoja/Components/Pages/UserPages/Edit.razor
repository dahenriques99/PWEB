@page "/admin/users/edit"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure
@using MyMedia.Infrastructure.Entities.enums
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Edit User</PageTitle>

<h1>Edit User</h1>

@if (User is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1 class="mb-4 text-center">Edit User</h1>
    <hr/>
    <div class="container mb-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <EditForm method="post" Model="User"
                          OnValidSubmit="UpdateUser" FormName="edit" Enhance>
                    <DataAnnotationsValidator/>
                    <ValidationSummary class="text-danger" role="alert"/>
                    <div class="mb-3">
                        <span class="text-danger">*</span>
                        <label for="name" class="form-label">Name:</label>
                        <InputText id="name" @bind-Value="User.Name" class="form-control" aria-required="true"/>
                        <ValidationMessage For="() => User.Name" class="text-danger"/>
                    </div>
                    <div class="mb-3">
                        <span class="text-danger">*</span>
                        <label for="surname" class="form-label">Surname:</label>
                        <InputText id="surname" @bind-Value="User.Surname" class="form-control" aria-required="true"/>
                        <ValidationMessage For="() => User.Surname" class="text-danger"/>
                    </div>
                    <div class="mb-3">
                        <span class="text-danger">*</span>
                        <label for="email" class="form-label">Email:</label>
                        <InputText id="email" @bind-Value="User.Email" class="form-control" aria-required="true"/>
                        <ValidationMessage For="() => User.Email" class="text-danger"/>
                    </div>
                    <div class="mb-3">
                        <span class="text-danger">*</span>
                        <label for="imagedata" class="form-label">Image:</label>
                        <InputFile id="imagedata" OnChange="OnImageChange" class="form-control"
                                   accept=".png, .jpg, .jpeg"/>
                        @if (_previewUrl is not null)
                        {
                            <img alt="" src="@_previewUrl" style="max-width: 200px; margin-top: 10px;"/>
                        }
                        <ValidationMessage For="() => User.ImageData" class="text-danger"/>
                    </div>

                    <label class="form-label">Roles:</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var role in Roles)
                        {
                            <div class="form-check me-3">
                                <InputCheckbox @bind-Value="role.IsSelected"
                                               class="form-check-input"/>
                                <label>@role.Name.ToString()</label>
                            </div>
                        }
                    </div>

                    <div class="text-center mt-4">
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <a href="/admin/users" class="btn btn-secondary">Back To List</a>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] private string Id { get; set; }

    private ApplicationUser? User { get; set; }

    private List<RoleSelectionModel> Roles { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        User = await context.Users.FindAsync(Id);
        if (User is null)
        {
            Nav.NavigateTo("notfound");
            return;
        }
        
        // Get the user's current roles
        var userRoles = await UserManager.GetRolesAsync(User);

        // Prepare the list of role models
        foreach (UserRoles role in Enum.GetValues(typeof(UserRoles)))
        {
            Roles.Add(new RoleSelectionModel
            {
                Name = role,
                IsSelected = userRoles.Contains(role.ToString())
            });
        }
    }

    private async Task UpdateUser()
    {
        var user = await UserManager.FindByIdAsync(User?.Id);
        if (user == null) return;

        if (Roles.Find(model => model.Name == UserRoles.Supplier) is { IsSelected: true } &&
            Roles.Find(model => model.Name == UserRoles.Client) is { IsSelected: true })
            Roles.Find(model => model.Name == UserRoles.Client).IsSelected = false;

        user.Name = User.Name;
        user.Email = User.Email;
        user.UserName = User.Email;
        user.PhoneNumber = User.PhoneNumber;

        var result = await UserManager.UpdateAsync(user);
        if (!result.Succeeded)
        {
            // Handle error updating user
            return;
        }

        // Get the user's current roles
        var userRoles = await UserManager.GetRolesAsync(User!);
        var rolesToRemove = userRoles.Except(
            Roles
                .Where(r => r.IsSelected)
                .Select(r => r.Name.ToString())
        ).ToList();
        await UserManager.RemoveFromRolesAsync(user!, rolesToRemove);
        
        var rolesToAdd = Roles
            .Where(r => r.IsSelected)
            .Select(r => r.Name.ToString())
            .Except(userRoles)
            .ToList();
        await UserManager.AddToRolesAsync(user!, rolesToAdd);

        // Redirect to users list after saving
        Nav.NavigateTo("/admin/users");
    }

    private bool UserExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Products.Any(e => e.Id.Equals(id));
    }

    private string? _previewUrl;

    private async Task OnImageChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);
        User.ImageData = stream.ToArray(); //Only saves bytes

        //Creates pre visualization
        using var previewStream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(previewStream);
        var base64 = Convert.ToBase64String(previewStream.ToArray());
        _previewUrl = $"data:{file.ContentType};base64,{base64}";
    }

    public class RoleSelectionModel
    {
        public UserRoles Name { get; set; }
        public bool IsSelected { get; set; }
    }

}