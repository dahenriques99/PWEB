@page "/admin/users/edit"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure
@using MyMedia.Infrastructure.Entities.enums
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Edit User</PageTitle>

@if (User is null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2">Loading user…</p>
    </div>
}
else
{
    <div class="container my-5">
        <div class="card shadow-sm">
            <div class="card-body">

                <h2 class="text-center mb-4">Edit User</h2>
                <hr />

                <EditForm Model="User" OnValidSubmit="UpdateUser">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <!-- Image preview -->
                    <div class="text-center mb-4">
                        <img class="rounded-circle mb-2"
                             style="width:120px;height:120px;object-fit:cover"
                             src="@GetPreviewImage()" />

                        <InputFile OnChange="OnImageChange"
                                   class="form-control mt-2"
                                   accept=".png,.jpg,.jpeg" />
                    </div>

                    <!-- User info -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Name *</label>
                            <InputText class="form-control" @bind-Value="User.Name" />
                            <ValidationMessage For="() => User.Name" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Surname *</label>
                            <InputText class="form-control" @bind-Value="User.Surname" />
                            <ValidationMessage For="() => User.Surname" />
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label">Email *</label>
                            <InputText class="form-control" @bind-Value="User.Email" />
                            <ValidationMessage For="() => User.Email" />
                        </div>
                    </div>

                    <!-- Roles -->
                    <div class="border rounded p-3 mt-4">
                        <h5 class="mb-3">Roles</h5>

                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var role in Roles)
                            {
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="role.IsSelected" />
                                    <label class="form-check-label">
                                        @role.Name
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button class="btn btn-primary" type="submit">
                            Save Changes
                        </button>

                        <a class="btn btn-outline-secondary"
                           href="/admin/users">
                            Cancel
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@code {
    [SupplyParameterFromQuery] private string Id { get; set; }

    private ApplicationUser? User { get; set; }

    private List<RoleSelectionModel> Roles { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        User = await context.Users.FindAsync(Id);
        if (User is null)
        {
            Nav.NavigateTo("notfound");
            return;
        }
        
        // Get the user's current roles
        var userRoles = await UserManager.GetRolesAsync(User);

        // Prepare the list of role models
        foreach (UserRoles role in Enum.GetValues(typeof(UserRoles)))
        {
            Roles.Add(new RoleSelectionModel
            {
                Name = role,
                IsSelected = userRoles.Contains(role.ToString())
            });
        }
    }

    private async Task UpdateUser()
    {
        var user = await UserManager.FindByIdAsync(User?.Id);
        if (user == null) return;

        var supplier = Roles.First(r => r.Name == UserRoles.Supplier);
        var client = Roles.First(r => r.Name == UserRoles.Client);

        if (supplier.IsSelected)
            client.IsSelected = false;

        user.Name = User.Name;
        user.Email = User.Email;
        user.UserName = User.Email;
        user.PhoneNumber = User.PhoneNumber;

        var result = await UserManager.UpdateAsync(user);
        if (!result.Succeeded)
        {
            // Handle error updating user
            return;
        }

        // Get the user's current roles
        var userRoles = await UserManager.GetRolesAsync(User!);
        var rolesToRemove = userRoles.Except(
            Roles
                .Where(r => r.IsSelected)
                .Select(r => r.Name.ToString())
        ).ToList();
        await UserManager.RemoveFromRolesAsync(user!, rolesToRemove);
        
        var rolesToAdd = Roles
            .Where(r => r.IsSelected)
            .Select(r => r.Name.ToString())
            .Except(userRoles)
            .ToList();
        await UserManager.AddToRolesAsync(user!, rolesToAdd);

        // Redirect to users list after saving
        Nav.NavigateTo("/admin/users");
    }
    
    private string? _previewUrl;

    private async Task OnImageChange(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.Size > 2_000_000)
            throw new InvalidOperationException("Image too large (max 2MB)");

        using var stream = new MemoryStream();
        await file.OpenReadStream(2_000_000).CopyToAsync(stream);

        User!.ImageData = stream.ToArray();

        _previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(User.ImageData)}";
    }
    
    private string GetPreviewImage()
    {
        if (_previewUrl is not null)
            return _previewUrl;

        return User?.ImageData is { Length: > 0 } ? 
            $"data:image/png;base64,{Convert.ToBase64String(User.ImageData)}" : 
            "/img/default-user.png";
    }

    public class RoleSelectionModel
    {
        public UserRoles Name { get; set; }
        public bool IsSelected { get; set; }
    }

}