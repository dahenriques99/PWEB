@page "/admin/users/create"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure
@using MyMedia.Infrastructure.Entities.enums
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPasswordHasher<ApplicationUser> PasswordHasher
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Gestão de Utilizadores</PageTitle>

<div class="container my-5">
    <div class="card shadow-sm">
        <div class="card-body">

            <h2 class="text-center mb-4">Create User</h2>
            <hr />

            <EditForm Model="User" OnValidSubmit="AddUser">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <!-- User type -->
                <div class="mb-3">
                    <label class="form-label">
                        User Type <span class="text-danger">*</span>
                    </label>
                    <InputSelect class="form-select" @bind-Value="_clientType">
                        <option value="">-- Select type --</option>
                        @foreach (UserType type in Enum.GetValues(typeof(UserType)))
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>

                <!-- Image -->
                <div class="text-center mb-4">
                    <img class="rounded-circle mb-2"
                         style="width:120px;height:120px;object-fit:cover"
                         src="@GetPreviewImage()" />

                    <InputFile OnChange="OnImageChange"
                               class="form-control mt-2"
                               accept=".png,.jpg,.jpeg" />
                </div>

                <!-- User info -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Name *</label>
                        <InputText class="form-control" @bind-Value="User.Name" />
                        <ValidationMessage For="() => User.Name" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Surname *</label>
                        <InputText class="form-control" @bind-Value="User.Surname" />
                        <ValidationMessage For="() => User.Surname" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Email *</label>
                        <InputText class="form-control" @bind-Value="User.Email" />
                        <ValidationMessage For="() => User.Email" />
                    </div>
                </div>

                <!-- Password hint -->
                <div class="alert alert-info small">
                    Default password will be: <strong>Password123!</strong><br />
                    User should change it on first login.
                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-primary" type="submit">
                        Create User
                    </button>
                    <a class="btn btn-outline-secondary" href="/admin/users">
                        Cancel
                    </a>
                </div>
            </EditForm>
        </div>
    </div>
</div>


@code {
    [SupplyParameterFromForm] private ApplicationUser User { get; set; } = new();
    private UserType _clientType;
    
    private async Task AddUser()
    {
        User.PasswordHash = PasswordHasher.HashPassword(User, "Password123!");
        User.UserName = User.Email;
        User.Status = UserStatus.Pending;

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Users.Add(User);
        await context.SaveChangesAsync();

        switch (_clientType)
        {
            case UserType.Client:
                await UserManager.AddToRoleAsync(User, nameof(UserRoles.Client));
                break;

            case UserType.Supplier:
                await UserManager.AddToRoleAsync(User, nameof(UserRoles.Supplier));
                break;

            default:
                throw new InvalidOperationException("User type must be selected");
        }


        NavigationManager.NavigateTo("/admin/users");
    }

    private string GetPreviewImage()
    {
        if (_previewUrl is not null)
            return _previewUrl;

        return User.ImageData is { Length: > 0 } ? 
            $"data:image/png;base64,{Convert.ToBase64String(User.ImageData)}" : 
            "/img/default-user.png";
    }

    
    private string? _previewUrl;

    private async Task OnImageChange(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.Size > 2_000_000)
            throw new InvalidOperationException("Image too large (max 2MB)");

        using var stream = new MemoryStream();
        await file.OpenReadStream(2_000_000).CopyToAsync(stream);

        User.ImageData = stream.ToArray();
        _previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(User.ImageData)}";
    }

}