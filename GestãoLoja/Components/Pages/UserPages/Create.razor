@page "/admin/users/create"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MyMedia.Domain.Entities.enums
@using MyMedia.Infrastructure
@using MyMedia.Infrastructure.Entities.enums
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPasswordHasher<ApplicationUser> PasswordHasher
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Gestão de Utilizadores</PageTitle>

<h1 class="mb-4 text-center">Create User</h1>
<hr/>
<div class="container mb-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <EditForm method="post" Model="User" OnValidSubmit="AddUser" FormName="create">
                <DataAnnotationsValidator/>
                <ValidationSummary class="text-danger" role="alert"/>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="clienttype" class="form-label">Supplier:</label>
                    <InputSelect id="clienttype" @bind-Value="User.ClientType" class="form-select">
                        <option value="">-- select --</option>
                        @foreach (UserType type in Enum.GetValues(typeof(UserType)))
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => User.ClientType" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="User.Name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => User.Name" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="surname" class="form-label">Surname:</label>
                    <InputText id="surname" @bind-Value="User.Surname" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => User.Surname" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="User.Email" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => User.Email" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="imagedata" class="form-label">Image:</label>
                    <InputFile id="imagedata" OnChange="OnImageChange" class="form-control" accept=".png, .jpg, .jpeg"/>
                    @if (_previewUrl is not null)
                    {
                        <img alt="" src="@_previewUrl" style="max-width: 200px; margin-top: 10px;"/>
                    }
                    <ValidationMessage For="() => User.ImageData" class="text-danger"/>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/admin/users" class="btn btn-secondary">Back To List</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private ApplicationUser User { get; set; } = new();
    
    private async Task AddUser()
    {
        User.PasswordHash = PasswordHasher.HashPassword(User, "Password123!");
        User.UserName = User.Email;
        User.Status = UserStatus.Pending;
        
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Users.Add(User);
        await context.SaveChangesAsync();
        
        await UserManager.AddToRoleAsync(User, nameof(UserRole.Client));
        NavigationManager.NavigateTo("/admin/users");
    }
    
    private string? _previewUrl;

    private async Task OnImageChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);
        User.ImageData = stream.ToArray(); //Only saves bytes

        //Creates pre visualization
        using var previewStream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(previewStream);
        var base64 = Convert.ToBase64String(previewStream.ToArray());
        _previewUrl = $"data:{file.ContentType};base64,{base64}";
    }
}