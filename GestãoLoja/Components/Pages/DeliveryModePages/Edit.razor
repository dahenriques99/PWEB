@page "/deliverymodes/edit"
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit Delivery Mode</PageTitle>

@if (DeliveryMode is null)
{
    <p class="text-muted"><em>Loading delivery mode…</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Edit Delivery Mode</h3>
            <small class="text-muted">
                Update the delivery option details
            </small>
        </div>
    </div>

    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <EditForm Model="DeliveryMode"
                      OnValidSubmit="UpdateDeliveryMode"
                      FormName="edit"
                      Enhance>

                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                <div class="mb-3">
                    <label for="name" class="form-label">
                        Name <span class="text-danger">*</span>
                    </label>
                    <InputText id="name"
                               @bind-Value="DeliveryMode.Name"
                               class="form-control"
                               placeholder="e.g. Express Delivery" />
                    <ValidationMessage For="() => DeliveryMode.Name"
                                       class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="details" class="form-label">Details</label>
                    <InputText id="details"
                               @bind-Value="DeliveryMode.Details"
                               class="form-control"
                               placeholder="Optional description" />
                    <ValidationMessage For="() => DeliveryMode.Details"
                                       class="text-danger" />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a class="btn btn-outline-secondary"
                       href="/deliverymodes">
                        ← Back
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private DeliveryMode? DeliveryMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        DeliveryMode ??= await context.DeliveryModes.FirstOrDefaultAsync(m => m.Id == Id);

        if (DeliveryMode is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDeliveryMode()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Attach(DeliveryMode!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DeliveryModeExists(DeliveryMode!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/deliverymodes");
    }

    private bool DeliveryModeExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.DeliveryModes.Any(e => e.Id == id);
    }
}
