@page "/deliverymodes/delete"
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DeliveryMode</h2>
    <hr />
    @if (_deliveryMode is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@_deliveryMode.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Details</dt>
            <dd class="col-sm-10">@_deliveryMode.Details</dd>
        </dl>
        <EditForm method="post" Model="_deliveryMode" OnValidSubmit="DeleteDeliveryMode" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(_deliveryMode is null)">Delete</button>
            <a href="/deliverymodes" class="btn btn-secondary">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DeliveryMode? _deliveryMode;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _deliveryMode = await context.DeliveryModes.FirstOrDefaultAsync(m => m.Id == Id);

        if (_deliveryMode is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDeliveryMode()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.DeliveryModes.Remove(_deliveryMode!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/deliverymodes");
    }
}
