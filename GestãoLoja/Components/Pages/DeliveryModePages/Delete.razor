@page "/deliverymodes/delete"
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Delivery Mode</PageTitle>

@if (_deliveryMode is null)
{
    <p class="text-muted"><em>Loading delivery mode…</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 text-danger">Delete Delivery Mode</h3>
            <small class="text-muted">
                This action cannot be undone
            </small>
        </div>
    </div>

    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="alert alert-warning">
                <strong>Warning:</strong>
                You are about to permanently delete this delivery mode.
            </div>

            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@_deliveryMode.Name</dd>

                <dt class="col-sm-4">Details</dt>
                <dd class="col-sm-8">
                    @if (string.IsNullOrWhiteSpace(_deliveryMode.Details))
                    {
                        <span class="text-muted fst-italic">No details provided</span>
                    }
                    else
                    {
                        @_deliveryMode.Details
                    }
                </dd>
            </dl>

            <EditForm Model="_deliveryMode"
                      OnValidSubmit="DeleteDeliveryMode"
                      FormName="delete"
                      Enhance>

                <div class="d-flex justify-content-between mt-4">
                    <a class="btn btn-outline-secondary"
                       href="/deliverymodes">
                        ← Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Delete
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private DeliveryMode? _deliveryMode;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _deliveryMode = await context.DeliveryModes.FirstOrDefaultAsync(m => m.Id == Id);

        if (_deliveryMode is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDeliveryMode()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.DeliveryModes.Remove(_deliveryMode!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/deliverymodes");
    }
}
