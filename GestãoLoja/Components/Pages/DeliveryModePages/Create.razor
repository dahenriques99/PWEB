@page "/deliverymodes/create"
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Delivery Modes</PageTitle>

<h1>Create Delivery Modes</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="DeliveryMode" OnValidSubmit="AddDeliveryMode" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="name" class="form-label">Name:</label> 
                <InputText id="name" @bind-Value="DeliveryMode.Name" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => DeliveryMode.Name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="details" class="form-label">Details:</label> 
                <InputText id="details" @bind-Value="DeliveryMode.Details" class="form-control" /> 
                <ValidationMessage For="() => DeliveryMode.Details" class="text-danger" /> 
            </div>        
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary">Create</button>
                <a class="btn btn-secondary" href="/deliverymodes">Back to List</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private DeliveryMode DeliveryMode { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDeliveryMode()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.DeliveryModes.Add(DeliveryMode);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/deliverymodes");
    }
}
