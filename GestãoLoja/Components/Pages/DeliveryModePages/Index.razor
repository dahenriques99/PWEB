@page "/deliverymodes"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyMedia.Infrastructure.Entities
@using MyMedia.Infrastructure
@implements IAsyncDisposable
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory

<PageTitle>Delivery Modes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Delivery Modes</h3>
        <small class="text-muted">
            Manage the available delivery options for orders
        </small>
    </div>

    <a href="deliverymodes/create" class="btn btn-primary">
        + Create Delivery Mode
    </a>
</div>

<hr />

<QuickGrid Class="table table-striped align-middle"
           Items="_context.DeliveryModes">

    <PropertyColumn Title="Name"
                    Property="dm => dm.Name"
                    Sortable="true" />

    <PropertyColumn Title="Details"
                    Property="dm => dm.Details" />

    <TemplateColumn Title="Actions" Context="deliveryMode">
        <div class="btn-group btn-group-sm" role="group">
            <a class="btn btn-outline-primary"
               href="@($"deliverymodes/edit?id={deliveryMode.Id}")">
                Edit
            </a>
            <a class="btn btn-outline-secondary"
               href="@($"deliverymodes/details?id={deliveryMode.Id}")">
                Details
            </a>
            <a class="btn btn-outline-danger"
               href="@($"deliverymodes/delete?id={deliveryMode.Id}")">
                Delete
            </a>
        </div>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext _context = default!;

    protected override void OnInitialized()
    {
        _context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync()
        => await _context.DisposeAsync();
}