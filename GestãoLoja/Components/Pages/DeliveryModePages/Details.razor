@page "/deliverymodes/details"
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>DeliveryMode</h2>
    <hr />
    @if (_deliverymode is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@_deliverymode.Name</dd>
            <dt class="col-sm-2">Details</dt>
            <dd class="col-sm-10">@_deliverymode.Details</dd>
        </dl>
        <div class="mt-4">
            <a href="@($"/deliverymodes/edit?id={_deliverymode.Id}")" class="btn btn-primary">Edit</a>
            <a class="btn btn-secondary" href="/deliverymodes">Back to List</a>
        </div>
    }
</div>

@code {
    private DeliveryMode? _deliverymode;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _deliverymode = await context.DeliveryModes.FirstOrDefaultAsync(m => m.Id == Id);

        if (_deliverymode is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
