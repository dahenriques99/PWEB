@page "/orders/details"
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@using MyMedia.Infrastructure.Entities.enums
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Order Details</PageTitle>

<div class="container my-4">
    <h1 class="mb-4">Order Details</h1>

    @if (_order is null)
    {
        <p><em>Loading order…</em></p>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    Order #@_order.Id
                </h5>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Client</dt>
                    <dd class="col-sm-8">@_order.User.Name</dd>

                    <dt class="col-sm-4">Total Amount</dt>
                    <dd class="col-sm-8 fw-bold">
                        @_order.TotalAmount.ToString("0.00 €")
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @GetStatusClass(_order.Status)">
                            @GetStatusLabel(_order.Status)
                        </span>
                    </dd>

                    <dt class="col-sm-4">Order Date</dt>
                    <dd class="col-sm-8">
                        @_order.Date.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-4">Delivery Mode</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrEmpty(_order.DeliveryMode?.Name))
                        {
                            @($"—")
                        }
                        else
                        {
                            @_order.DeliveryMode.Name
                        }
                    </dd>
                </dl>
            </div>

            <div class="card-footer bg-transparent text-end">
                <a class="btn btn-outline-secondary me-2"
                   href="/orders">
                    Back to List
                </a>
                <button class="btn btn-success" @onclick="() => SetStatus(OrderStatus.PaymentAccepted)">Accept</button>
                <button class="btn btn-danger" @onclick="() => SetStatus(OrderStatus.Cancelled)">Cancel</button>
                <button class="btn btn-secondary" @onclick="() => SetStatus(OrderStatus.Shipped)">Ship</button>
            </div>
        </div>
        @if (_order?.OrderItems?.Any() == true)
        {
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-white">
                    <strong>Items</strong>
                </div>
                <div class="card-body">
                    @foreach (var it in _order.OrderItems)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2 align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(it.Product?.ImageData is { Length: > 0 }
                                              ? $"data:image/jpeg;base64,{Convert.ToBase64String(it.Product.ImageData)}"
                                              : "/img/no-image.jpg")"
                                     class="rounded border"
                                     style="width:48px;height:48px;object-fit:cover" />

                                <div>
                                    <div class="fw-semibold">@it.Product?.Name</div>
                                    <div class="text-muted small">@it.Price.ToString("0.00") €</div>
                                </div>
                            </div>

                            <div class="text-end">
                                <div>x @it.Quantity</div>
                                <div class="fw-semibold">
                                    @((it.Price * it.Quantity).ToString("0.00")) €
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private Order? _order;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        _order = await context.Orders
            .Include(o => o.User)
            .Include(o => o.DeliveryMode)
            .Include(o => o.OrderItems)
            .ThenInclude(oi => oi.Product)
            .FirstOrDefaultAsync(o => o.Id == Id);

        if (_order is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private static string GetStatusClass(OrderStatus status) => status switch
    {
        OrderStatus.InCart          => "bg-secondary",
        OrderStatus.PendingPayment => "bg-warning text-dark",
        OrderStatus.PaymentFailed  => "bg-danger",
        OrderStatus.PaymentAccepted=> "bg-info",
        OrderStatus.Shipped         => "bg-primary",
        OrderStatus.Completed       => "bg-success",
        OrderStatus.Cancelled       => "bg-dark",
        _                           => "bg-secondary"
    };
    
    private static string GetStatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.InCart           => "In Cart",
        OrderStatus.PendingPayment   => "Pending Payment",
        OrderStatus.PaymentFailed    => "Payment Failed",
        OrderStatus.PaymentAccepted  => "Payment Accepted",
        OrderStatus.Shipped          => "Shipped",
        OrderStatus.Completed        => "Completed",
        OrderStatus.Cancelled        => "Cancelled",
        _                            => status.ToString()
    };

    private async Task SetStatus(OrderStatus status)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var order = await db.Orders.FirstOrDefaultAsync(o => o.Id == Id);
        if (order is null) return;

        if (order.Status != OrderStatus.Cancelled && status == OrderStatus.Cancelled)
        {
            await db.Entry(order).Collection(o => o.OrderItems).LoadAsync();
            foreach (var item in order.OrderItems)
            {
                var product = await db.Products.FirstOrDefaultAsync(p => p.Id == item.ProductId);
                if (product != null)
                    product.Stock += item.Quantity;
            }
        }
        
        order.Status = status;
        await db.SaveChangesAsync();
        NavigationManager.NavigateTo("/orders");
    }
}