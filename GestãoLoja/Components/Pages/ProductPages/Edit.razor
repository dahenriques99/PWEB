@page "/products/edit"
@attribute [Authorize(Roles = "Admin,Employee")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@using MyMedia.Infrastructure.Entities.enums
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Edit Product</PageTitle>

<div class="container my-4">
    @if (Product is null)
    {
        <p class="text-muted text-center"><em>Loading product…</em></p>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header">
                <h3>Edit Product</h3>
                <small class="text-muted">@Product.Name</small>
            </div>

            <div class="card-body">
                <EditForm Model="Product" OnValidSubmit="UpdateProduct" Enhance>
                    <DataAnnotationsValidator/>
                    <ValidationSummary class="text-danger"/>

                    <div class="row">
                        <!-- Left: Form -->
                        <div class="col-md-8">
                            <div class="mb-3">
                                <span class="text-danger">*</span>
                                <label class="form-label">Name</label>
                                <InputText @bind-Value="Product.Name" class="form-control"/>
                                <ValidationMessage For="() => Product.Name"/>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <InputText @bind-Value="Product.Description" class="form-control"/>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <span class="text-danger">*</span>
                                    <label class="form-label">Price (€)</label>
                                    <InputNumber @bind-Value="Product.Price" class="form-control"/>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <span class="text-danger">*</span>
                                    <label class="form-label">Final Price (€)</label>
                                    <InputNumber @bind-Value="Product.FinalPrice" class="form-control"/>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <span class="text-danger">*</span>
                                    <label class="form-label">Stock</label>
                                    <InputNumber @bind-Value="Product.Stock" class="form-control"/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-12">
                                <label class="form-label">Categories</label>
                                @if (_categories is null)
                                {
                                    <div class="text-muted">Loading...</div>
                                }
                                else
                                {
                                    <div class="row">
                                        @foreach (var c in _categories)
                                        {
                                            var checkedNow = _selectedCats.Contains(c.Id);
                                            <div class="col-12 col-md-6 col-lg-4">
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@checkedNow"
                                                           @onchange="e => ToggleCat(c.Id, (bool)e.Value!)" />
                                                    <label class="form-check-label">@c.Name</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Right: Image -->
                        <div class="col-md-4">
                            <label class="form-label">Product Image</label>

                            <div class="mb-3 text-center">
                                @if (_previewUrl is not null)
                                {
                                    <img src="@_previewUrl"
                                         class="img-fluid rounded border mb-2"
                                         style="max-height: 200px;"/>
                                }
                                else if (Product.ImageData is not null)
                                {
                                    <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(Product.ImageData)}")"
                                         class="img-fluid rounded border mb-2"
                                         style="max-height: 200px;"/>
                                }
                                else
                                {
                                    <div class="text-muted">No image</div>
                                }
                            </div>

                            <InputFile OnChange="OnImageChange"
                                       class="form-control"
                                       accept=".png,.jpg,.jpeg"/>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="d-flex justify-content-start gap-2 mt-4">
                            <div class="form-check form-switch mt-3">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="IsProductActive"/>
                                <label class="form-check-label">
                                    @if (IsProductActive)
                                    {
                                        <span class="text-success fw-semibold">Product Active</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">Product Disabled</span>
                                    }
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Changes
                        </button>
                        <a class="btn btn-secondary" href="/products">
                            Cancel
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] private int Id { get; set; }

    private Product? Product;
    private IEnumerable<Category>? _categories;
    private readonly HashSet<int> _selectedCats = new();

    private bool IsProductActive
    {
        get => Product!.Status == ProductStatus.Active;
        set => Product!.Status = value
            ? ProductStatus.Active
            : ProductStatus.Pending;
    }
    
    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        Product = await context.Products
            .AsNoTracking()
            .Include(p => p.ProductCategories)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (Product is null)
        {
            Nav.NavigateTo("/notfound");
            return;
        }

        _categories = await context.Categories
            .OrderBy(o => o.Name)
            .ToListAsync();

        _selectedCats.Clear();
        foreach (var pc in Product.ProductCategories)
            _selectedCats.Add(pc.CategoryId);
    }
    

    private void ToggleCat(int id, bool isChecked)
    {
        if (isChecked) _selectedCats.Add(id);
        else _selectedCats.Remove(id);
    }
    
    private async Task UpdateProduct()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var existing = await context.Products
            .Include(p => p.ProductCategories)
            .FirstOrDefaultAsync(p => p.Id == Product!.Id);

        if (existing is null)
        {
            Nav.NavigateTo("/notfound");
            return;
        }

        existing.Name = Product!.Name;
        existing.Description = Product.Description;
        existing.Price = Product.Price;
        existing.FinalPrice = Product.FinalPrice;
        existing.Stock = Product.Stock;
        existing.Status = Product.Status;

        if (Product.ImageData is not null)
            existing.ImageData = Product.ImageData;

        // categories
        existing.ProductCategories.Clear();
        foreach (var catId in _selectedCats)
        {
            existing.ProductCategories.Add(new ProductCategory
            {
                ProductId = existing.Id,
                CategoryId = catId
            });
        }

        await context.SaveChangesAsync();
        Nav.NavigateTo("/products");
    }

    private string? _previewUrl;

    private async Task OnImageChange(InputFileChangeEventArgs e)
    {
        const long maxFileSize = 5 * 1024 * 1024;

        using var stream = e.File.OpenReadStream(maxFileSize);
        using var ms = new MemoryStream();

        await stream.CopyToAsync(ms);

        Product!.ImageData = ms.ToArray();
        _previewUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(Product.ImageData)}";
    }

}
