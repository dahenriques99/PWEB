@page "/products/create"
@attribute [Authorize(Roles = "Admin, Worker")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure
@using MyMedia.Infrastructure.Entities
@using MyMedia.Infrastructure.Entities.enums
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Create Product</PageTitle>

<h1>Create Product</h1>

<hr/>
<div class="container mb-4">
    <div class="row justify-content-center">
        <div class="col-md-4 col-lg-6">
            <EditForm method="post" Model="Product" OnValidSubmit="AddProduct" FormName="create" Enhance>
                <DataAnnotationsValidator/>
                <ValidationSummary class="text-danger" role="alert"/>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="supplierid" class="form-label">Supplier:</label>
                    <InputSelect id="supplierid" @bind-Value="Product.SupplierId" class="form-select">
                        <option value="">Select a Supplier</option>
                        @foreach (var supplier in _suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Product.SupplierId" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Product.Name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Product.Name" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="Product.Description" class="form-control"/>
                    <ValidationMessage For="() => Product.Description" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="price" class="form-label">Price:</label>
                    <InputNumber id="price" @bind-Value="Product.Price" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Product.Price" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="finalprice" class="form-label">FinalPrice:</label>
                    <InputNumber id="finalprice" @bind-Value="Product.FinalPrice" class="form-control"
                                 aria-required="true"/>
                    <ValidationMessage For="() => Product.FinalPrice" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="stock" class="form-label">Stock:</label>
                    <InputNumber id="stock" @bind-Value="Product.Stock" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Product.Stock" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <label for="imagedata" class="form-label">Image:</label>
                    <InputFile id="imagedata" OnChange="OnImageChange" class="form-control" accept=".png, .jpg, .jpeg"/>
                    @if (_previewUrl is not null)
                    {
                        <img alt="" src="@_previewUrl" style="max-width: 200px; margin-top: 10px;"/>
                    }
                    else
                    {
                        <p>No image selected</p>
                    }
                    <ValidationMessage For="() => Product.ImageData" class="text-danger"/>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a class="btn btn-secondary" href="/products">Back to List</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private Product Product { get; set; } = new();
    private List<ApplicationUser> _suppliers = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Users.AsQueryable();
        _suppliers = query.Where(u => context.UserRoles
            .Where(ur => ur.UserId == u.Id)
            .Join(context.Roles, ur => ur.RoleId, r => r.Id, (ur, r) => r.Name)
            .Contains(nameof(UserRoles.Supplier)))
            .ToList();
    }

    private async Task AddProduct()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        
        context.Products.Add(Product);
        await context.SaveChangesAsync();

        Nav.NavigateTo("/products");
    }

    private string? _previewUrl;

    private async Task OnImageChange(InputFileChangeEventArgs e)
    {
        var file = e.File;

        using var ms = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(ms);
        var bytes = ms.ToArray();

        // Save to entity
        Product.ImageData = bytes;

        // Create preview
        var base64 = Convert.ToBase64String(bytes);
        _previewUrl = $"data:{file.ContentType};base64,{base64}";
    }
}