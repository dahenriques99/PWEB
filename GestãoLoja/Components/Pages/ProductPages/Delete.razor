@page "/products/delete"
@attribute [Authorize(Roles = "Admin,Worker")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MyMedia.Infrastructure.Entities
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Delete Product</PageTitle>

<div class="container my-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Product</h4>
        </div>

        <div class="card-body">
            @if (_product is null)
            {
                <p class="text-muted"><em>Loading product…</em></p>
            }
            else
            {
                <div class="alert alert-warning">
                    <strong>Warning:</strong> This action is irreversible.
                </div>

                @if (!_canDelete)
                {
                    <div class="alert alert-danger">
                        This product cannot be deleted because it is associated with existing orders.
                    </div>
                }

                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@_product.Name</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@_product.Description</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@($"{_product.Price:0.00} €")</dd>

                    <dt class="col-sm-3">Final Price</dt>
                    <dd class="col-sm-9">@($"{_product.FinalPrice:0.00} €")</dd>

                    <dt class="col-sm-3">Stock</dt>
                    <dd class="col-sm-9">@_product.Stock</dd>

                    <dt class="col-sm-3">Image</dt>
                    <dd class="col-sm-9">
                        @if (_product.ImageData is not null)
                        {
                            <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(_product.ImageData)}")"
                                 class="img-fluid rounded border"
                                 style="max-height: 200px;" />
                        }
                        else
                        {
                            <span class="text-muted">No image</span>
                        }
                    </dd>
                </dl>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-danger"
                            @onclick="DeleteProduct"
                            disabled="@(!_canDelete)">
                        Delete
                    </button>

                    <button class="btn btn-secondary" @onclick="Cancel">
                        Cancel
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private Product? _product;
    private bool _canDelete = true;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        _product = await context.Products
            .Include(p => p.OrderItems)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (_product is null)
        {
            Nav.NavigateTo("/notfound");
            return;
        }

        _canDelete = !_product.OrderItems.Any();
    }

    private async Task DeleteProduct()
    {
        if (!_canDelete || _product is null)
            return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var product = await context.Products.FindAsync(_product.Id);
        if (product is null)
        {
            Nav.NavigateTo("/notfound");
            return;
        }

        context.Products.Remove(product);
        await context.SaveChangesAsync();

        Nav.NavigateTo("/products");
    }

    private void Cancel() => Nav.NavigateTo("/products");
}
