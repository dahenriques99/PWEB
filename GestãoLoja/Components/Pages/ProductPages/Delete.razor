@page "/products/delete"
@attribute [Authorize(Roles = "Admin,Worker")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MyMedia.Infrastructure.ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
@if (!_canDelete)
{
    <p class="text-danger"><em>Unable to delete product!</em></p>
}
<div>
    <h2>Product</h2>
    <hr/>
    @if (_product is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@_product.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@_product.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@_product.Price</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FinalPrice</dt>
            <dd class="col-sm-10">@_product.FinalPrice</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Stock</dt>
            <dd class="col-sm-10">@_product.Stock</dd>
        </dl>
        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            @if (_product.ImageData != null)
            {
                <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(_product.ImageData)}")"
                     alt="@_product.Name"
                     style="max-width:200px"/>
            }
            else
            {
                <img src="/img/no-image.jpg" style="max-width: 100px; max-height: 100px;" alt="No product image"/>
            }
        </dd>
        <EditForm method="post" Model="_product" OnValidSubmit="DeleteProduct" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(_product is null)">Delete</button>
            <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </EditForm>
    }
</div>

@code {
    private Product? _product;

    [SupplyParameterFromQuery] private int Id { get; set; }

    private bool _canDelete = true;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _product = await context.Products.FirstOrDefaultAsync(m => m.Id == Id);

        if (_product is null)
        {
            Nav.NavigateTo("notfound");
        }
    }

    private async Task DeleteProduct()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        if (_product is { OrderItems.Count: > 0 })
        {
            _canDelete = false;
            return;
        }

        if (_canDelete)
        {
            context.Products.Remove(_product!);
            await context.SaveChangesAsync();
            Nav.NavigateTo("/products");
        }
    }

    private void Cancel() => Nav.NavigateTo("/products");
}
